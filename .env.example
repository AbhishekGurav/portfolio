# Public base URL used for SEO (canonical, sitemap, robots, Open Graph, JSON-LD).
# Set this to your custom domain once you have one, e.g. https://abhishekgurav.com
#
# Resolution order (see content/site.ts):
#   1. NEXT_PUBLIC_SITE_URL      (this variable — takes priority)
#   2. VERCEL_URL                (auto-set on Vercel deploys)
#   3. http://localhost:3000     (local fallback)
#
# No trailing slash needed; it is stripped automatically.
NEXT_PUBLIC_SITE_URL=
